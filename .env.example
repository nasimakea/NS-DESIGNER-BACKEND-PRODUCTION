# ---------- Required ----------
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/ns-designer?retryWrites=true&w=majority
# 48+ random characters. Generate:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# The website URL(s) allowed to call this API, comma separated, no trailing slash
FRONTEND_URL=http://localhost:3000

# ---------- First admin (used only by `npm run seed`) ----------
ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@yourdomain.com
# 10+ chars with upper, lower, number and symbol
ADMIN_PASSWORD=

# ---------- Images (Cloudinary) ----------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=ns-designer

# ---------- WhatsApp order alerts (optional - Meta WhatsApp Cloud API) ----------
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ADMIN_NUMBER=917903381728
# Optional approved template (needed to message a number outside the 24h window).
# Template body must have 4 variables: order id, customer, phone, total.
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en

# ---------- Customer confirmation e-mail (optional) ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=NS Designer <no-reply@yourdomain.com>

# ---------- Customer sign-up / forgot-password OTP e-mails (Brevo) ----------
# Brevo -> SMTP & API -> API keys -> "Generate a new API key".
# The sender must be a verified sender/domain in Brevo (Senders, Domains & Dedicated IPs).
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=NS Designer

# ---------- AI stylist agent (separate FastAPI service, private) ----------
AGENT_URL=http://127.0.0.1:8000
# Same long random value as AGENT_SHARED_SECRET in the agent's .env
AGENT_SHARED_SECRET=
AGENT_TIMEOUT_MS=28000

# ---------- Real visitor IP for rate limiting ----------
# Set the SAME long random value here and in the website's PROXY_SHARED_SECRET.
# (node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
PROXY_SHARED_SECRET=
# Fallback if the secret is not set: proxies in front of this API (Render = 1)
TRUSTED_PROXY_HOPS=1

# "lax" works because the website proxies /api to this server (recommended).
COOKIE_SAMESITE=lax
